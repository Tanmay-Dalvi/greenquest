# GreenQuest Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://greenquest.onrender.com

# LLM Provider Configuration
# Options: "ollama", "fallback", "hosted"
MODEL_PROVIDER=ollama

# Ollama Settings (Local open-weight inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_SECONDS=25.0

# Optional Hosted Provider Settings (OpenAI / Open-weight compatible HTTP endpoint)
# Designed as an optional adapter, not a hard requirement
HOSTED_API_BASE_URL=https://api.together.xyz/v1
HOSTED_API_KEY=
HOSTED_MODEL=google/gemma-3-1b-it

# Orchestration & Guardrail Controls
MAX_SAFETY_RETRIES=2
LOG_LEVEL=INFO
FORCE_FALLBACK=false
